---
interface Props { categories?: string[]; action?: string }
const { categories = [], action = '#' } = Astro.props;
---
<form class="product-filter" action={action} method="get"><label for="product-search">Cari produk<input id="product-search" name="q" type="search" placeholder="Nama produk" /></label><label for="product-category">Kategori<select id="product-category" name="category"><option value="">Semua kategori</option>{categories.map((category) => <option value={category}>{category}</option>)}</select></label><button type="submit">Terapkan</button></form>
<style>.product-filter{display:flex;align-items:end;gap:1rem;flex-wrap:wrap;padding:1rem;border:1px solid var(--color-border)}label{display:grid;gap:.4rem;color:var(--color-ink-subtle);font-size:.7rem;letter-spacing:.08em;text-transform:uppercase}input,select{min-width:12rem;border:1px solid var(--color-border);padding:.65rem;background:var(--color-surface);color:var(--color-ink);font:inherit}button{border:1px solid var(--color-accent);padding:.65rem 1rem;background:var(--color-accent);color:#1d221f;font:inherit;cursor:pointer}</style>
