---
interface Props { name: string; price: string; image?: string; href?: string; category?: string; alt?: string }
const { name, price, image, href = '#', category, alt = name } = Astro.props;
---
<a class="product-card" href={href}><div class="product-media">{image ? <img src={image} alt={alt} loading="lazy" /> : <span aria-hidden="true">{name.slice(0, 1)}</span>}</div><div class="product-meta">{category && <small>{category}</small>}<h3>{name}</h3><p>{price}</p></div></a>
<style>
 .product-card{display:block;color:inherit;text-decoration:none}.product-media{display:grid;place-items:center;aspect-ratio:1;background:color-mix(in srgb,var(--color-ink) 5%,transparent);overflow:hidden}.product-media img{width:100%;height:100%;object-fit:cover;transition:transform .3s ease}.product-media span{font-family:var(--font-display);font-size:4rem;color:var(--color-accent)}.product-card:hover img{transform:scale(1.03)}.product-meta{padding-top:.85rem}.product-meta small{color:var(--color-ink-subtle);font-size:.65rem;letter-spacing:.12em;text-transform:uppercase}.product-meta h3{margin:.35rem 0;font-size:.95rem;font-weight:500}.product-meta p{margin:0;color:var(--color-accent-soft);font-size:.85rem}
</style>
