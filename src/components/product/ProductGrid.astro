---
interface Props { products: Array<{ name: string; price: string; image?: string; href?: string; category?: string }> }
import ProductCard from './ProductCard.astro';
const { products } = Astro.props;
---
<div class="product-grid">{products.map((product) => <ProductCard {...product} />)}</div>
<style>.product-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:2rem 1.25rem}@media(max-width:900px){.product-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:600px){.product-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem .75rem}}</style>
