---
interface Props { copyright?: string; links?: Array<{ label: string; href: string }> }
const { copyright = '© 2026 Atelier', links = [] } = Astro.props;
---
<footer class="footer"><span>{copyright}</span><nav aria-label="Navigasi footer">{links.map((link) => <a href={link.href}>{link.label}</a>)}</nav></footer>
<style>
  .footer { display:flex; justify-content:space-between; gap:1rem; padding:1.25rem 0; border-top:1px solid var(--color-border); color:var(--color-ink-subtle); font-size:.7rem; } nav { display:flex; gap:1rem; } a { color:inherit; text-decoration:none; } a:hover { color:var(--color-accent-soft); } @media(max-width:500px){.footer{display:grid;}}
</style>
