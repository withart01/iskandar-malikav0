---
interface Props { title: string; description?: string; actionLabel?: string; actionHref?: string }
const { title, description, actionLabel, actionHref } = Astro.props;
---
<header class="admin-header"><div><p class="eyebrow">Admin workspace</p><h1>{title}</h1>{description && <p class="description">{description}</p>}</div>{actionLabel && actionHref && <a class="action" href={actionHref}>{actionLabel}</a>}</header>
<style>.admin-header{display:flex;align-items:end;justify-content:space-between;gap:1.5rem;padding:2rem 0;border-bottom:1px solid var(--color-border)}.eyebrow{margin:0 0 .6rem;color:var(--color-accent-soft);font-size:.65rem;letter-spacing:.14em;text-transform:uppercase}.admin-header h1{margin:0;font-size:clamp(2rem,5vw,3.5rem);font-weight:500;letter-spacing:-.04em}.description{margin:.75rem 0 0;color:var(--color-ink-muted);font-size:.85rem}.action{padding:.7rem 1rem;background:var(--color-accent);color:var(--color-surface);font-size:.75rem;text-decoration:none;white-space:nowrap}.action:hover{background:var(--color-accent-soft)}@media(max-width:600px){.admin-header{align-items:start;flex-direction:column}.action{width:100%;text-align:center}}</style>
