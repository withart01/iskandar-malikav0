---
interface Props { name: string; price: string; quantity: number; image?: string; removeHref?: string }
const { name, price, quantity, image, removeHref = '#' } = Astro.props;
---
<article class="cart-item"><div class="cart-image">{image ? <img src={image} alt={name} /> : <span aria-hidden="true">{name.slice(0, 1)}</span>}</div><div class="cart-detail"><h3>{name}</h3><p>{price}</p><span>Jumlah: {quantity}</span></div><a class="remove" href={removeHref}>Hapus</a></article>
<style>.cart-item{display:grid;grid-template-columns:5rem 1fr auto;gap:1rem;align-items:center;padding:1rem 0;border-bottom:1px solid var(--color-border)}.cart-image{display:grid;place-items:center;aspect-ratio:1;background:color-mix(in srgb,var(--color-ink) 5%,transparent);overflow:hidden}.cart-image img{width:100%;height:100%;object-fit:cover}.cart-image span{font-family:var(--font-display);font-size:2rem;color:var(--color-accent)}h3{margin:0 0 .3rem;font-size:.9rem;font-weight:500}.cart-detail p,.cart-detail span{margin:.25rem 0;color:var(--color-ink-muted);font-size:.8rem}.remove{color:var(--color-ink-subtle);font-size:.7rem;text-decoration:underline}.remove:hover{color:var(--color-accent-soft)}</style>
