---
interface Props {
	href?: string;
	class?: string;
}

const { href, class: className = '' } = Astro.props;
const classes = `card ${className}`.trim();
---

{href ? (
	<a class={classes} href={href}><slot /></a>
) : (
	<article class={classes}><slot /></article>
)}

<style>
	.card { display: block; padding: 1.25rem; border: 1px solid var(--color-border); border-radius: 0.5rem; background: color-mix(in srgb, var(--color-ink) 3%, transparent); color: inherit; text-decoration: none; transition: border-color 0.2s ease, transform 0.2s ease; }
	.card[href]:hover { border-color: var(--color-accent); transform: translateY(-2px); }
	.card:focus-visible { outline: 2px solid var(--color-accent-soft); outline-offset: 3px; }
</style>
