---
interface Props {
	label: string;
	name: string;
	type?: 'text' | 'email' | 'password' | 'search' | 'number';
	placeholder?: string;
	required?: boolean;
	autocomplete?: string;
}

const { label, name, type = 'text', placeholder, required = false, autocomplete } = Astro.props;
---

<label class="field" for={name}>
	<span class="field__label">{label}</span>
	<input id={name} name={name} type={type} placeholder={placeholder} required={required} autocomplete={autocomplete} />
</label>

<style>
	.field { display: grid; gap: 0.5rem; color: var(--color-ink); }
	.field__label { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
	.field input { width: 100%; min-height: 44px; padding: 0.7rem 0.85rem; border: 1px solid var(--color-border); border-radius: 0.35rem; background: transparent; color: var(--color-ink); font: inherit; }
	.field input::placeholder { color: var(--color-ink-subtle); }
	.field input:focus-visible { outline: 2px solid var(--color-accent-soft); outline-offset: 2px; border-color: var(--color-accent); }
</style>
