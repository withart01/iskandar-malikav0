---
import UserLayout from '../../layouts/UserLayout.astro';
import ProductGrid from '../../components/product/ProductGrid.astro';
import Button from '../../components/common/Button.astro';

const products = [
  { name: 'Ceramic Vessel', price: 'Rp 450.000', category: 'Home', href: '/products/ceramic-vessel', image: 'https://images.unsplash.com/photo-1578500494198-246f612d03b3?w=500&h=500&fit=crop' },
  { name: 'Linen Throw', price: 'Rp 650.000', category: 'Textile', href: '/products/linen-throw', image: 'https://images.unsplash.com/photo-1598103442097-8b74394b95c6?w=500&h=500&fit=crop' },
  { name: 'Brass Candlestick', price: 'Rp 380.000', category: 'Decor', href: '/products/brass-candlestick', image: 'https://images.unsplash.com/photo-1546868871-7041f2a55e12?w=500&h=500&fit=crop' },
  { name: 'Oak Wood Shelf', price: 'Rp 1.200.000', category: 'Furniture', href: '/products/oak-wood-shelf', image: 'https://images.unsplash.com/photo-1579428924281-d87e4e2f3a22?w=500&h=500&fit=crop' },
  { name: 'Cotton Pillowcase', price: 'Rp 280.000', category: 'Textile', href: '/products/cotton-pillowcase', image: 'https://images.unsplash.com/photo-1578500494198-246f612d03b3?w=500&h=500&fit=crop' },
  { name: 'Marble Coaster Set', price: 'Rp 320.000', category: 'Decor', href: '/products/marble-coaster', image: 'https://images.unsplash.com/photo-1578500494198-246f612d03b3?w=500&h=500&fit=crop' },
  { name: 'Rattan Basket', price: 'Rp 420.000', category: 'Storage', href: '/products/rattan-basket', image: 'https://images.unsplash.com/photo-1596040707873-e47e61952e6d?w=500&h=500&fit=crop' },
  { name: 'Minimal Desk Lamp', price: 'Rp 750.000', category: 'Lighting', href: '/products/desk-lamp', image: 'https://images.unsplash.com/photo-1565636192335-14c5a5ce5450?w=500&h=500&fit=crop' }
];
---

<UserLayout title="Belanja — NARA" description="Jelajahi koleksi NARA." brand="NARA" links={[
  { label: 'Tentang', href: '#' },
  { label: 'Koleksi', href: '/products' },
  { label: 'Kontak', href: '#' }
]} actionLabel="Masuk" actionHref="/login">
  <section class="products-hero">
    <div class="products-intro">
      <p class="eyebrow">Koleksi NARA</p>
      <h1>Pilihan Esensial</h1>
      <p>Kurasi produk untuk ruang dan ritme keseharian Anda.</p>
    </div>
  </section>

  <section class="products-section" aria-label="Daftar produk">
    <ProductGrid products={products} />
  </section>

  <section class="products-footer">
    <p>Tertarik dengan koleksi lengkapnya? <Button href="/login" variant="ghost">Masuk untuk melanjutkan</Button></p>
  </section>
</UserLayout>

<style>
  .products-hero { padding: 4rem 0 3rem; border-bottom: 1px solid var(--color-border); }
  .products-intro { max-width: 680px; }
  .eyebrow { display: block; margin-bottom: 1rem; color: var(--color-ink-subtle); font-size: .65rem; letter-spacing: .16em; text-transform: uppercase; }
  h1 { margin: 0 0 1rem; font-size: 3rem; font-weight: 500; }
  .products-intro > p:last-child { margin: 0; max-width: 450px; color: var(--color-ink-muted); font-size: 1rem; }
  .products-section { padding: 3rem 0; }
  .products-footer { padding: 2rem 0; border-top: 1px solid var(--color-border); text-align: center; color: var(--color-ink-muted); }
  .products-footer p { display: flex; align-items: center; justify-content: center; gap: 1rem; margin: 0; }
  @media (max-width: 640px) { .products-hero { padding: 2.5rem 0 2rem; } h1 { font-size: 2rem; } .products-section { padding: 2rem 0; } .products-footer p { flex-direction: column; gap: .5rem; } }
</style> 
