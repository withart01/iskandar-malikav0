---
import UserLayout from '../layouts/UserLayout.astro';
import ProductGrid from '../components/product/ProductGrid.astro';
import Button from '../components/common/Button.astro';

const featuredProducts = [
  { name: 'Ceramic Vessel', price: 'Rp 450.000', category: 'Home', href: '/products/ceramic-vessel', image: 'https://images.unsplash.com/photo-1578500494198-246f612d03b3?w=500&h=500&fit=crop' },
  { name: 'Linen Throw', price: 'Rp 650.000', category: 'Textile', href: '/products/linen-throw', image: 'https://images.unsplash.com/photo-1598103442097-8b74394b95c6?w=500&h=500&fit=crop' },
  { name: 'Brass Candlestick', price: 'Rp 380.000', category: 'Decor', href: '/products/brass-candlestick', image: 'https://images.unsplash.com/photo-1546868871-7041f2a55e12?w=500&h=500&fit=crop' },
  { name: 'Oak Wood Shelf', price: 'Rp 1.200.000', category: 'Furniture', href: '/products/oak-wood-shelf', image: 'https://images.unsplash.com/photo-1579428924281-d87e4e2f3a22?w=500&h=500&fit=crop' }
];
---

<UserLayout title="Home — NARA" description="Koleksi esensial NARA untuk ruang dan keseharian." brand="NARA" links={[
  { label: 'Koleksi', href: '/products' },
  { label: 'Tentang', href: '#about' },
  { label: 'Kontak', href: 'mailto:hello@nara.store' }
]} actionLabel="Masuk" actionHref="/login">
  <main>
    <section class="home-hero" aria-labelledby="home-title">
      <p class="eyebrow">Koleksi terbaru / NARA 2026</p>
      <h1 id="home-title">Benda baik untuk ruang yang berarti.</h1>
      <p class="hero-copy">Pilihan esensial yang dikurasi untuk membuat keseharian terasa lebih tenang, hangat, dan personal.</p>
      <Button href="/products" variant="primary">Jelajahi koleksi</Button>
    </section>

    <section class="featured" aria-labelledby="featured-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Pilihan NARA</p>
          <h2 id="featured-title">Favorit musim ini</h2>
        </div>
        <a href="/products">Lihat semua <span aria-hidden="true">↗</span></a>
      </div>
      <ProductGrid products={featuredProducts} />
    </section>

    <section class="about" id="about" aria-labelledby="about-title">
      <p class="eyebrow">Tentang NARA</p>
      <h2 id="about-title">Lebih sedikit, lebih berarti.</h2>
      <p>Kami percaya benda yang baik tidak perlu berlebihan. Setiap pilihan dibuat untuk menemani ruang dan ritme hidup Anda.</p>
    </section>
  </main>
</UserLayout>

<style>
  .home-hero { padding: 5rem 0 6rem; border-bottom: 1px solid var(--color-border); }
  .eyebrow { margin: 0 0 1rem; color: var(--color-ink-subtle); font-size: .65rem; letter-spacing: .16em; text-transform: uppercase; }
  h1 { max-width: 760px; margin: 0 0 1.25rem; font-size: clamp(2.8rem, 7vw, 5.5rem); font-weight: 500; line-height: .98; letter-spacing: -.04em; }
  .hero-copy { max-width: 460px; margin: 0 0 2rem; color: var(--color-ink-muted); line-height: 1.7; }
  .featured { padding: 4rem 0; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2rem; }
  h2 { margin: 0; font-size: 2rem; font-weight: 500; letter-spacing: -.03em; }
  .section-heading a { color: var(--color-ink); font-size: .8rem; text-decoration: none; }
  .section-heading a:hover { color: var(--color-accent-soft); }
  .about { max-width: 620px; padding: 4rem 0 6rem; border-top: 1px solid var(--color-border); }
  .about h2 { margin-bottom: 1rem; font-size: clamp(2rem, 5vw, 3.5rem); }
  .about p:last-child { max-width: 450px; margin: 0; color: var(--color-ink-muted); line-height: 1.7; }
  @media (max-width: 640px) { .home-hero { padding: 3.5rem 0 4rem; } .section-heading { align-items: start; flex-direction: column; gap: 1rem; } .featured { padding: 3rem 0; } }
</style>
</UserLayout>
