---
import Layout from '../layouts/Layout.astro';
---

<Layout title="NARA — Segera Hadir" description="NARA menghadirkan pilihan esensial untuk ruang dan keseharian.">
	<main class="splash-shell">
		<div class="ambient ambient-one" aria-hidden="true"></div>
		<div class="ambient ambient-two" aria-hidden="true"></div>

		<header class="site-header">
			<a class="wordmark" href="/" aria-label="NARA home">NARA<span>.</span></a>
			<p class="header-note">EST. 2026 / JAKARTA</p>
		</header>

		<section class="hero" aria-labelledby="hero-title">
			<div class="eyebrow"><span></span> A new point of view</div>
			<h1 id="hero-title">Benda baik untuk<br /><em>hidup yang berarti.</em></h1>
			<p class="hero-copy">Sebuah koleksi terkurasi untuk ruang, tubuh, dan ritme keseharian. Kami sedang menyiapkan sesuatu yang layak ditunggu.</p>
			<a class="enter-link" href="#opening">
				<span>Masuk ke dunia NARA</span>
				<span class="arrow" aria-hidden="true">↗</span>
			</a>
		</section>

		<footer class="site-footer" id="opening">
			<p>ONLINE STORE / COMING SOON</p>
			<p>Ikuti perjalanan kami <a href="mailto:hello@nara.store">hello@nara.store</a></p>
			<span class="footer-index">01 — 01</span>
		</footer>
	</main>
</Layout>

<style>
	:global(*) { box-sizing: border-box; }
	:global(body) { background: #1d221f; color: #f0eee6; }
	.splash-shell { min-height: 100svh; position: relative; overflow: hidden; display: flex; flex-direction: column; padding: 30px clamp(24px, 5vw, 76px) 28px; isolation: isolate; }
	.ambient { position: absolute; border-radius: 50%; filter: blur(1px); pointer-events: none; z-index: -1; }
	.ambient-one { width: min(42vw, 600px); aspect-ratio: 1; right: -12vw; top: 11%; background: radial-gradient(circle at 35% 35%, rgba(192, 146, 97, .48), rgba(105, 72, 49, .1) 53%, transparent 70%); }
	.ambient-two { width: min(36vw, 500px); aspect-ratio: 1; left: -15vw; bottom: -25%; background: radial-gradient(circle, rgba(103, 127, 102, .28), transparent 68%); }
	.site-header, .site-footer { display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(240, 238, 230, .22); padding-bottom: 18px; }
	.wordmark { color: inherit; text-decoration: none; font-size: 1.05rem; font-weight: 700; letter-spacing: .26em; }
	.wordmark span { color: #c99768; }
	.header-note, .site-footer, .eyebrow { font-size: .65rem; letter-spacing: .16em; text-transform: uppercase; }
	.header-note { color: rgba(240, 238, 230, .62); margin: 0; }
	.hero { width: min(100%, 760px); margin: auto auto 10vh; }
	.eyebrow { display: flex; align-items: center; gap: 12px; color: #d5a578; margin-bottom: 28px; }
	.eyebrow span { display: block; width: 36px; height: 1px; background: currentColor; }
	h1 { max-width: 820px; margin: 0; font-size: clamp(3.8rem, 9vw, 8.4rem); line-height: .91; letter-spacing: -.075em; font-weight: 500; }
	h1 em { color: #c99768; font-family: Georgia, 'Times New Roman', serif; font-weight: 400; letter-spacing: -.09em; }
	.hero-copy { max-width: 330px; margin: 38px 0 32px; color: rgba(240, 238, 230, .65); font-size: .95rem; line-height: 1.6; }
	.enter-link { display: inline-flex; align-items: center; gap: 22px; color: inherit; text-decoration: none; font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; border-bottom: 1px solid rgba(240, 238, 230, .5); padding-bottom: 10px; transition: color .2s ease, gap .2s ease; }
	.enter-link:hover, .enter-link:focus-visible { color: #d5a578; gap: 28px; }
	.arrow { font-size: 1.15rem; line-height: .7; }
	.site-footer { position: relative; border-top: 1px solid rgba(240, 238, 230, .22); border-bottom: 0; padding-top: 18px; color: rgba(240, 238, 230, .5); }
	.site-footer p { margin: 0; }
	.site-footer a { color: #d5a578; text-decoration: none; }
	.footer-index { position: absolute; left: 50%; transform: translateX(-50%); }
	@media (max-width: 640px) { .splash-shell { padding: 22px 20px 22px; } .header-note { font-size: .55rem; } .hero { margin-bottom: 12vh; } h1 { font-size: clamp(3.5rem, 17vw, 6rem); } .site-footer { display: grid; gap: 10px; font-size: .57rem; } .footer-index { position: static; transform: none; } }
</style>
