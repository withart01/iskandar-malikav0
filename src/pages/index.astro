---
import Layout from '../layouts/Layout.astro';
---

<Layout title="NARA — Segera Hadir" description="NARA menghadirkan pilihan esensial untuk ruang dan keseharian.">
	<main class="splash-shell">
		<div class="ambient ambient-one" aria-hidden="true"></div>
		<div class="ambient ambient-two" aria-hidden="true"></div>

		<header class="site-header">
			<a class="wordmark" href="/" aria-label="NARA home">NARA<span>.</span></a>
			<p class="header-note">EST. 2026 / JAKARTA</p>
		</header>

		<section class="hero" aria-labelledby="hero-title">
			<div class="eyebrow"><span></span> A new point of view</div>
			<h1 id="hero-title">Benda baik untuk<br /><em>hidup yang berarti.</em></h1>
			<p class="hero-copy">Sebuah koleksi terkurasi untuk ruang, tubuh, dan ritme keseharian. Kami sedang menyiapkan sesuatu yang layak ditunggu.</p>
			<div class="splash-actions">
				<a class="enter-link" href="/home">
					<span>Lanjut ke home</span>
					<span class="arrow" aria-hidden="true">↗</span>
				</a>
				<a class="login-link" href="/login">Login untuk akun lama atau admin</a>
			</div>
		</section>

		<footer class="site-footer" id="opening">
			<p>ONLINE STORE / COMING SOON</p>
			<p>Ikuti perjalanan kami <a href="mailto:hello@nara.store">hello@nara.store</a></p>
			<span class="footer-index">01 — 01</span>
		</footer>
	</main>
</Layout>
